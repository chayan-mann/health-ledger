# Ignore Node.js dependencies
node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore environment variable files
.env
client/.env
server/.env

# Dependency directories
client/node_modules/
server/node_modules/

# Python-related ignores
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.env
*.venv
*.egg
*.eggs/
*.egg-info/
dist/
build/

# Ignore editor and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.swn
*.bak

# Ignore compiled code
*.class
*.dll
*.exe
*.out
*.pyc
*.pyo
*.pyd

# Ignore build outputs
client/build/
server/build/
dist/
coverage/
*.coverage

# Ignore temporary files
*.tmp
*.temp
*.pid

# Ignore package lock files (optional if you don't want them in the repo)
package-lock.json
yarn.lock

# Ignore test coverage directories
coverage/
.nyc_output/

# Ignore macOS system files
*.DS_Store

# Ignore environment settings for editors
.env.local
.env.development.local
.env.test.local
.env.production.local
